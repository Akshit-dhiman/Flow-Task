# Database - Railway will provide this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret - use a strong random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Frontend URL (for CORS) - set to your Vercel/Netlify URL in production
CLIENT_URL=http://localhost:5173

# Port (Railway sets this automatically, don't override it)
PORT=8080
